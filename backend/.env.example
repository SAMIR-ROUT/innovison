SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-publishable-or-service-key-here

# Copy this file to .env and replace with your real Supabase connection string from Project Settings > Database > URI.
DATABASE_URL=postgresql://postgres:your_password_here@db.your-project-ref.supabase.co:5432/postgres

# CORS Allowed Origins (comma-separated or * for all)
ALLOWED_ORIGINS=*

# Secret API Key for write operations (POST, PATCH)
API_KEY=your-secret-api-key-here
